# ================================================================
# D-Admin Engine — Environment Variables
# Copy this file to .env and fill in values
# ================================================================

# ---- Server ----
# LOCAL:      PORT=3001
# AWS EB:     PORT is auto-assigned by Elastic Beanstalk via PORT env var
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ---- CORS (Allowed Frontend Origins) ----
# LOCAL:      ALLOWED_ORIGINS=http://localhost:3000
# PRODUCTION: ALLOWED_ORIGINS=https://d-admin-drj.vercel.app
ALLOWED_ORIGINS=https://d-admin-drj.vercel.app

# ---- Storage ----
# Directory where user project sandboxes are created (npm install, npm run dev, etc.)
# LOCAL:      leave blank (defaults to ./projects)
# AWS EC2/EB: use an absolute path to a persistent folder
# PROJECTS_DIR=/home/ec2-user/d-admin-engine/projects