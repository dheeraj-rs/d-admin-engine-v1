# Environment Variables for D-Admin Engine
# Copy this file to .env and fill in the values

# ---- Server Config ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ---- CORS (Allowed Frontend Origins) ----
# Comma-separated list of allowed origins, e.g. your Vercel URL.
# Leave empty to allow all origins (easier for development).
ALLOWED_ORIGINS=https://d-admin-drj.vercel.app
