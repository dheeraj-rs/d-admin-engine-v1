# ================================================================
# D-Admin Engine — Environment Variables
# ================================================================

# ----------------------------------------------------------------
# 1. LOCAL DEVELOPMENT
# Copy this file to .env and use these values:
# ----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------
# 2. PRODUCTION (AWS Elastic Beanstalk)
# Do NOT use a .env file. 
# Set these variables via the AWS EB Console or the EB CLI:
# eb setenv PORT=8080 HOST=0.0.0.0 NODE_ENV=production ALLOWED_ORIGINS=https://d-admin-drj.vercel.app
# ----------------------------------------------------------------
# PORT=8080
# HOST=0.0.0.0
# NODE_ENV=production
# ALLOWED_ORIGINS=https://d-admin-drj.vercel.app