# Environment Variables for D-Admin Engine
# Copy this file to .env and fill in the values

# ---- Server Config ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ---- CORS (Allowed Frontend Origins) ----
# Comma-separated list. Use your Vercel URL for production.
ALLOWED_ORIGINS=https://d-admin-drj.vercel.app

# ---- Vercel Frontend Env Vars (set these in Vercel Dashboard) ----
# NEXT_PUBLIC_CODE_RUNNER_API_URL=https://<your-render-url>.onrender.com
# NEXT_PUBLIC_CODE_RUNNER_WS_URL=wss://<your-render-url>.onrender.com/ws
