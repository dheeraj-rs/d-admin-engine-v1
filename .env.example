# Environment Variables for D-Admin Engine
# Copy this file to .env and set values

# ---- Server ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ---- CORS ----
# Comma-separated frontend origins.
# Set to your Vercel frontend URL in production.
ALLOWED_ORIGINS=https://d-admin-drj.vercel.app

# ---- Storage ----
# Directory where project sandboxes are created.
# On AWS EC2/Elastic Beanstalk, use an absolute path or keep default (./projects)
# PROJECTS_DIR=/home/ec2-user/d-admin-engine/projects